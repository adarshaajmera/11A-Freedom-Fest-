{
  "name": "sanyal-newsstand-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Sanyal's Newsstand - a first-person 3D newspaper shop with a scored examination and a global leaderboard",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:init": "wrangler d1 migrations apply sanyal-newsstand --local",
    "db:init:remote": "wrangler d1 migrations apply sanyal-newsstand --remote",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  },
  "license": "ISC"
}
